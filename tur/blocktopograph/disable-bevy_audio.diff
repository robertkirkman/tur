-//!    App::new()
-//!         .add_plugins((MinimalPlugins, AssetPlugin::default(), AudioPlugin::default()))
-//!         .add_systems(Startup, play_background_audio)
-//!         .run();
-//! }
-//!
-//! fn play_background_audio(asset_server: Res<AssetServer>, mut commands: Commands) {
-//!     commands.spawn((
